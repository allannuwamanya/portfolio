# Canonical site origin, no trailing slash. Used for metadata, the sitemap and
# robots.txt. Set it in Cloudflare Pages -> Settings -> Environment variables.
NEXT_PUBLIC_SITE_URL=https://allannuwamanya.dev

# Public origin of the Cloudflare R2 bucket that holds event/experience photos.
# Leave blank to serve images from this repo's public/ folder instead.
# e.g. https://assets.allannuwamanya.dev  or  https://pub-xxxx.r2.dev
NEXT_PUBLIC_ASSETS_URL=

# Contact form endpoint. Leave blank to fall back to a prefilled mailto: link.
# e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Local only: used by `npm run deploy` and `npm run upload`. Put the real values
# --- in .env.local, which is gitignored. Never commit them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
